{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnownDocumentsRegistry",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "document_number",
      "document_type",
      "effective_status",
      "verification_status",
      "review_state",
      "data_version"
    ],
    "properties": {
      "id": { "type": "string" },
      "document_number": { "type": "string" },
      "document_type": { "type": "string" },
      "title": { "type": ["string", "null"] },
      "topic_aliases": { "type": "array", "items": { "type": "string" } },
      "query_patterns": { "type": "array", "items": { "type": "string" } },
      "issuer": { "type": ["string", "null"] },
      "issue_date": { "type": ["string", "null"] },
      "effective_date": { "type": ["string", "null"] },
      "effective_status": {
        "type": "string",
        "enum": ["co_hieu_luc", "het_hieu_luc", "het_hieu_luc_mot_phan", "ngung_hieu_luc", "unknown"]
      },
      "status_as_of": { "type": ["string", "null"] },
      "replaces": { "type": "array", "items": { "type": "string" } },
      "amends": { "type": "array", "items": { "type": "string" } },
      "superseded_by": { "type": "array", "items": { "type": "string" } },
      "official_source_urls": { "type": "array", "items": { "type": "string" } },
      "verification_status": {
        "type": "string",
        "enum": ["verified", "unverified", "partial"]
      },
      "verified_at": { "type": ["string", "null"] },
      "review_state": {
        "type": "string",
        "enum": ["draft", "reviewed", "published"]
      },
      "data_version": { "type": "integer", "minimum": 1 }
    }
  }
}
